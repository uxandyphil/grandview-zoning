{
  "manifest_version": 3,
  "name": "Grandview permits collector",
  "version": "1.1",
  "description": "Collects Grandview Heights and Upper Arlington permits from the cities' OpenGov portals when you click Run now, and publishes them to the grandview-zoning site.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://grandviewheightsoh.portal.opengov.com/*",
    "https://upperarlingtonoh.portal.opengov.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grandview permits",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
